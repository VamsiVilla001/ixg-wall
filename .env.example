# Settings for `npm run dev:hosted`, a local test of the hosted website:
#   copy this file to .env (never committed), adjust, then npm run dev:hosted
# On a server, deploy/setup.sh writes the same settings to /etc/ixg-wall/ixg-wall.env.
# All of them are read in backend/config.js.

# Run as a website: sign-in required; no wall window or laptop telemetry.
IXG_HOSTED=1
# The address people open: https://... in production, this for a local test.
PUBLIC_URL=http://localhost:8090
PORT=8090
HOST=127.0.0.1
# The admin password, 8+ characters. Everyone else signs in with a user link an admin
# generates in Settings. Changing it signs everyone out.
IXG_PASSWORD=change-me-local-test
# Optional: a YouTube Data API key kept on the server (otherwise paste one in Settings).
YOUTUBE_API_KEY=
# Optional: the Google OAuth client for the channel sign-in (ingest health), instead of
# entering it in Settings. Its redirect URI must be PUBLIC_URL/api/youtube/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: the Slack app's Bot User OAuth Token (xoxb-…) and the channel ID (C…) that
# screenshots are posted to, instead of entering them in Settings. Only a wall whose backend
# takes the screenshots (a laptop) posts them.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional: the Microsoft app (Azure app registration) the OneDrive upload signs in with,
# instead of entering it in Settings. Its Web redirect URI must be PUBLIC_URL/api/onedrive/callback.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Source screenshots are taken by the server in a headless Chrome when one is installed
# (DEPLOY.md), into IXG_DATA_DIR/screenshots/<session name>/ unless set here, and posted to
# Slack. IXG_SERVER_CAPTURE=0 leaves them to admins' browsers with the Feed Meter instead.
IXG_SCREENSHOT_DIR=
IXG_SERVER_CAPTURE=
# The background browser keeps the live sessions' feeds' YouTube pages open (muted, 144p) so
# a screenshot takes about a second instead of a cold start: how many at most (default 6;
# measured 200-340 MB and a tenth of a core each, plus ~450 MB for the browser). 0 keeps
# none, opening each page only for its shot.
IXG_SHOT_PRELOAD=
# Optional: once the Feed Meter extension is on the Chrome Web Store, its page and store ID,
# so the wall's install prompt offers one-click "Add to Chrome" (extension/README.md).
IXG_EXTENSION_STORE_URL=
IXG_EXTENSION_IDS=
# Where the wall, key and audience history live. Keep tests in their own folder so the
# real wall (%LOCALAPPDATA%\IXG Wall) is never seeded with test feeds.
IXG_DATA_DIR=./.data
