{
  "name": "ixg-wall",
  "version": "1.1.0",
  "private": true,
  "description": "Low-latency YouTube monitoring wall with live-edge drift correction, scheduled player refresh and a managed wall browser",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "wall": "node server.js --open",
    "dev:hosted": "node --env-file=.env server.js",
    "test": "node --test",
    "build": "node build/build-exe.js"
  },
  "devDependencies": {
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^4.0.1"
  }
}
