{
  "manifest_version": 3,
  "name": "IXG Wall Feed Meter",
  "version": "1.0.0",
  "description": "Measures each YouTube feed on the IXG Wall: real bitrate, data received, connection speed, buffer, latency mode and dropped frames.",
  "key": "",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "meter.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "manifest.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
